{
  "name": "@inkandswitch/rain-diagram-wasm",
  "version": "0.1.0",
  "private": true,
  "description": "Rain and certflow diagrams from plain text: the Rust core as Wasm, packaged for Node, bundlers, browsers, workers, and script tags",
  "keywords": [
    "capabilities",
    "certflow",
    "keyhive",
    "rain-diagram",
    "wasm"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkandswitch/downpour.git",
    "directory": "javascript/rain-diagram-wasm"
  },
  "type": "module",
  "main": "./dist/cjs/node.cjs",
  "module": "./dist/esm/bundler.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/esm/bundler.js",
    "./dist/esm/node.js",
    "./dist/esm/web.js",
    "./dist/esm/workerd.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": {
        "import": "./dist/esm/workerd.js",
        "require": "./dist/cjs/web.cjs"
      },
      "node": {
        "import": "./dist/esm/node.js",
        "require": "./dist/cjs/node.cjs"
      },
      "browser": {
        "import": "./dist/esm/bundler.js",
        "require": "./dist/cjs/web.cjs"
      },
      "import": "./dist/esm/web.js",
      "require": "./dist/cjs/web.cjs"
    },
    "./slim": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/slim.js",
      "require": "./dist/cjs/slim.cjs"
    },
    "./wasm": "./dist/rain-diagram-wasm.wasm",
    "./wasm-base64": {
      "import": "./dist/esm/wasm-base64.js",
      "require": "./dist/cjs/wasm-base64.cjs"
    },
    "./iife": "./dist/iife/index.js"
  }
}